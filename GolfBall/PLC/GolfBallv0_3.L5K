			'			0:
			'				Actuate_T1_Diverter := 0;
			'				Actuate_T2_Diverter := 0;
			'				Actuate_T3_Diverter := 0;
			'			1:
			'				Actuate_T1_Diverter := 1;
			'				Actuate_T2_Diverter := 0;
			'				Actuate_T3_Diverter := 0;	
