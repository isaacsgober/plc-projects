		ST_ROUTINE Auto_Feed (Description := "Feeding cylinder step-based machine.")
			'//----// Resume handling: //----//
			'IF Feed_Resume_OS THEN
			'    Ball_Feeder_Step        := 00;   // every return to auto re-homes, same as a Stop
			'    Feeder_Motion_Storage := Ball_Feeder_Retracted OR Ball_Feeder_Intermediate
			'                               OR Ball_Feeder_Extended;   // no phantom edge on resume
			'END_IF;
			'
			'//----// Motion one-shot: //----//
			'Feeder_Motion_Detected_OS := (Ball_Feeder_Retracted OR Ball_Feeder_Intermediate OR Ball_Feeder_Extended)
			'                                  AND NOT Feeder_Motion_Storage;
			'Feeder_Motion_Storage := Ball_Feeder_Retracted OR Ball_Feeder_Intermediate OR Ball_Feeder_Extended;
			'
			'//----// Lift timeout: //----//
			'IF Feeder_Extend_Count < 5 THEN
			'    Feeder_Lift_Timeout_Timer.PRE := 4000;
			'ELSE
			'    Feeder_Lift_Timeout_Timer.PRE := 6000;
			'END_IF;
			'Feeder_Lift_Timeout_Timer.TimerEnable := Lift_Ball_Feeder;
			'Feeder_Lift_Timeout_Timer.Reset       := NOT Lift_Ball_Feeder OR Feed_Resume_OS;
			'TONR(Feeder_Lift_Timeout_Timer);
			'
			'// Lift margin monitor: longest normal stroke of each type, in ms
			'IF Ball_Feeder_Step = 10 THEN
			'    IF Feeder_Extend_Count < 5 THEN
			'        IF Feeder_Lift_Timeout_Timer.ACC > Lift_Time_Max THEN Lift_Time_Max := Feeder_Lift_Timeout_Timer.ACC; END_IF;
			'    ELSE
			'        IF Feeder_Lift_Timeout_Timer.ACC > Lift_Time_Max_Full THEN Lift_Time_Max_Full := Feeder_Lift_Timeout_Timer.ACC; END_IF;
			'    END_IF;
			'END_IF;
			'
			'IF Feeder_Lift_Timeout_Timer.DN AND NOT Feeder_Motion_Detected_OS THEN
			'    Fault_Feeder_Lift_Timeout := 1;
			'END_IF;
			'
			'//----// Drop timeout: //----//
			'IF Feeder_Extend_Count < 5 THEN
			'    Feeder_Drop_Timeout_Timer.PRE := 3000;
			'ELSE
			'    Feeder_Drop_Timeout_Timer.PRE := 5000;
			'END_IF;
			'Feeder_Drop_Timeout_Timer.TimerEnable := Drop_Ball_Feeder;
			'Feeder_Drop_Timeout_Timer.Reset       := NOT Drop_Ball_Feeder OR Feed_Resume_OS;
			'TONR(Feeder_Drop_Timeout_Timer);
			'IF Feeder_Drop_Timeout_Timer.DN AND NOT Ball_Feeder_Retracted THEN
			'    Fault_Feeder_Drop_Timeout := 1;
			'END_IF;
			'
			'//----// Recovery timer: //----//
			'Feeder_Recovery_Timer.TimerEnable := (Ball_Feeder_Step = 00);
			'Feeder_Recovery_Timer.Reset       := Ball_Feeder_Retracted OR Feed_Resume_OS;
			'Feeder_Recovery_Timer.PRE         := 5000;
			'TONR(Feeder_Recovery_Timer);
			'
			'//----// Watchdog: //----//
			'Feeder_Watchdog_Timer.TimerEnable := (Lift_Ball_Feeder OR Drop_Ball_Feeder) AND (Ball_Feeder_Step <> 00);
			'Feeder_Watchdog_Timer.Reset       := Feeder_Motion_Detected_OS OR Feed_Resume_OS;
			'Feeder_Watchdog_Timer.PRE         := 5000;
			'TONR(Feeder_Watchdog_Timer);
			'IF Feeder_Watchdog_Timer.DN THEN
			'    Fault_Feeder_Watchdog := 1;
			'END_IF;
			'
			'//----// Feeder dropped dwell: //----//
			'Ball_Feeder_Retracted_Timer.TimerEnable := Ball_Feeder_Retracted;
			'Ball_Feeder_Retracted_Timer.Reset       := NOT Ball_Feeder_Retracted OR Feed_Resume_OS;
			'Ball_Feeder_Retracted_Timer.PRE         := 400;
			'TONR(Ball_Feeder_Retracted_Timer);
			'
			'//----------------// Recovery //---------------------//|
			'	IF Feeder_Fault AND NOT Feeder_Fault_Active THEN
			'    	Feeder_Fault_Active := 1;
			'    	Ball_Feeder_Step := 00;
			'	END_IF;
			'	
			'		
			'			
			'CASE Ball_Feeder_Step OF
			'	99:// HARD FAULT
			'	// --------------------------------------------------
			'	 
			'		Lift_Ball_Feeder := 0;
			'		Drop_Ball_Feeder := 0;
			'		Feeder_Homing := 0;
			'		Feeder_Hard_Fault_HMI := 1;    // Hard Fault flag to HMI
			'	
			'		IF HMI_Fault_Reset_PB THEN 
			'			Ball_Feeder_Step := 00;    // Retry Recovery
			'			
			'			Feeder_Fault_Active := 0;
			'		END_IF;
			'	00:// RECOVERY / INIT
			'	// --------------------------------------------------
			'	  
			'		Lift_Ball_Feeder := 0;
			'	 	Drop_Ball_Feeder := 1;
			'	 	Feeder_Homing := 1;
			'	 
			'	 
			'		IF Ball_Feeder_Retracted THEN 
			'			Ball_Feeder_Step := 05;
			'			Feeder_Hard_Fault_HMI := 0;
			'			Fault_Feeder_Drop_Timeout := 0;
			'			Fault_Feeder_Lift_Timeout := 0;
			'			Fault_Feeder_Watchdog := 0;
			'			Drop_Ball_Feeder := 0;
			'			IF Feeder_Fault_Active THEN
			'	    	Feeder_Recovery_Attempt_Counter := Feeder_Recovery_Attempt_Counter + 1;
			'			Feeder_Recovery_Total := Feeder_Recovery_Total + 1;
			'			END_IF;
			'		ELSIF Feeder_Recovery_Timer.DN THEN 
			'			Ball_Feeder_Step := 99;
			'		END_IF;
			'	05:// WAIT FOR START
			'	// --------------------------------------------------
			'	
			'    	Lift_Ball_Feeder := 0;
			'    	Drop_Ball_Feeder := 0;
			'		Feeder_Homing := 0;
			'		Feeder_Fault_Active := 0;
			'    	IF Run_Latch AND NOT Magazine_Full THEN
			'        	Ball_Feeder_Step := 10;
			'    	END_IF;
			'
			'	10:// LIFT FEED CYLINDER
			'	// --------------------------------------------------
			'	
			'    	Lift_Ball_Feeder := 1;
			'    	Drop_Ball_Feeder := 0;
			'    	IF Feeder_Extend_Count < 5 THEN
			'
			'        	IF Ball_Feeder_Intermediate OR Ball_Feeder_Extended THEN
			'            	Ball_Feeder_Step := 20;
			'				Feeder_Recovery_Attempt_Counter := 0;
			'        	END_IF;
			'
			'    	ELSE
			'        	IF Ball_Feeder_Extended THEN
			'            	Ball_Feeder_Step := 20;
			'            	Feeder_Extend_Count := 0;
			'				Feeder_Recovery_Attempt_Counter := 0;
			'        	END_IF;
			'    	END_IF;
			'
			'	20:// DROP FEED CYLINDER
			'	// --------------------------------------------------
			'	
			'    	Lift_Ball_Feeder := 0;
			'    	Drop_Ball_Feeder := 1;
			'    	IF Ball_Feeder_Retracted THEN
			'        	Ball_Feeder_Step := 25;
			'    	END_IF;
			'		
			'	25:// FEED CYLINDER DWELL
			'	// --------------------------------------------------
			'		
			'		IF Ball_Feeder_Retracted_Timer.DN THEN
			'			Ball_Feeder_Step := 30;
			'		END_IF;
			'		
			'	30:// CYCLE COMPLETE / LOOP
			'	// --------------------------------------------------
			'    	IF Magazine_Full THEN
			'        	Lift_Ball_Feeder := 0;
			'        	Drop_Ball_Feeder := 0;
			'        	Ball_Feeder_Step := 0;
			'        	Feeder_Extend_Count := 0;
			'
			'    	ELSE 
			'       	 	Feeder_Extend_Count := Feeder_Extend_Count + 1;
			'        	Ball_Feeder_Step := 05;
			'    	END_IF;
			'	
			'END_CASE;
		END_ST_ROUTINE

		ST_ROUTINE Auto_Sort (Description := "Sorting step-based machine.")
			'//----// Resume handling: //----//
			'IF Sort_Resume_OS THEN
			'    Color_Sort_Step := 0;   // every return to auto restarts the sort cycle
			'END_IF;
