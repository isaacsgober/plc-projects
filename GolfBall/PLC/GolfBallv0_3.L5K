			'ELSE
			'    T1_TargetColor := T1_Color[idx1];
			'END_IF;
			'
			'IF (T2Full OR (idx2 < 0) OR (idx2 > 7)) THEN
			'    T2_TargetColor := -1;
			'ELSE
			'    T2_TargetColor := T2_Color[idx2];
			'END_IF;
			'
			'IF (T3Full OR (idx3 < 0) OR (idx3 > 7)) THEN
			'    T3_TargetColor := -1;
			'ELSE
			'    T3_TargetColor := T3_Color[idx3];
			'END_IF;
		END_ST_ROUTINE

