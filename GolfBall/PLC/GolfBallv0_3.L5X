<Programs>
<Program Name="Initialize" TestEdits="false" MainRoutineName="Initialization" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Initialization" Type="ST">
<Description>
<![CDATA[Initialize Outputs and Flags]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[GSV(Program,THIS,MajorFaultRecord,major_fault_record.Time_Low);]]>
</Line>
<Line Number="1">
<![CDATA[		major_fault_record.Type := 0;]]>
</Line>
<Line Number="2">
<![CDATA[		major_fault_record.Code := 0;]]>
</Line>
<Line Number="3">
<![CDATA[		SSV(Program,THIS,MajorFaultRecord,major_fault_record.Time_Low);]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[// FORCE SAFE OUTPUTS]]>
</Line>
<Line Number="6">
<![CDATA[// -------------------------------]]>
</Line>
<Line Number="7">
<![CDATA[    Lift_Ball_Feeder := 0;]]>
</Line>
<Line Number="8">
<![CDATA[    Drop_Ball_Feeder := 0;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[    Actuate_T1_Diverter := 0;]]>
</Line>
<Line Number="11">
<![CDATA[    Actuate_T2_Diverter := 0;]]>
</Line>
<Line Number="12">
<![CDATA[    Actuate_T3_Diverter := 0;]]>
</Line>
<Line Number="13">
<![CDATA[	]]>
</Line>
<Line Number="14">
<![CDATA[	Actuate_T1_Drop_Advance := 0;]]>
</Line>
<Line Number="15">
<![CDATA[	Actuate_T1_Drop_Release := 0;]]>
</Line>
<Line Number="16">
<![CDATA[	Actuate_T2_Drop_Advance := 0;]]>
</Line>
<Line Number="17">
<![CDATA[	Actuate_T2_Drop_Release := 0;]]>
</Line>
<Line Number="18">
<![CDATA[	Actuate_T3_Drop_Advance := 0;]]>
</Line>
<Line Number="19">
<![CDATA[	Actuate_T3_Drop_Release := 0;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[    Retract_Color_Advance_Cylinder := 0;]]>
</Line>
<Line Number="22">
<![CDATA[    Retract_Color_Release_Cylinder := 0;]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[    Run_Light := 0;]]>
</Line>
<Line Number="25">
<![CDATA[]]>
</Line>
<Line Number="26">
<![CDATA[    //  RESET MACHINE STATE]]>
</Line>
<Line Number="27">
<![CDATA[    // -------------------------------]]>
</Line>
<Line Number="28">
<![CDATA[    Run_Latch := 0;]]>
</Line>
<Line Number="29">
<![CDATA[	System_Mode := 30;]]>
</Line>
<Line Number="30">
<![CDATA[    Feeder_Fault_Active := 0;]]>
</Line>
<Line Number="31">
<![CDATA[	Feeder_Recovery_Attempt_Counter := 0;]]>
</Line>
<Line Number="32">
<![CDATA[    Feeder_Homing := 0;]]>
</Line>
<Line Number="33">
<![CDATA[]]>
</Line>
<Line Number="34">
<![CDATA[    Ball_Feeder_Step := 0;     // start in recovery/home]]>
</Line>
<Line Number="35">
<![CDATA[    Color_Sort_Step := 0;]]>
</Line>
<Line Number="36">
<![CDATA[]]>
</Line>
<Line Number="37">
<![CDATA[    // CLEAR FAULTS]]>
</Line>
<Line Number="38">
<![CDATA[    // -------------------------------]]>
</Line>
<Line Number="39">
<![CDATA[    Fault_Feeder_Drop_Timeout := 0;]]>
</Line>
<Line Number="40">
<![CDATA[    Fault_Feeder_Lift_Timeout := 0;]]>
</Line>
<Line Number="41">
<![CDATA[    Fault_Feeder_Watchdog := 0;]]>
</Line>
<Line Number="42">
<![CDATA[]]>
</Line>
<Line Number="43">
<![CDATA[    // RESET INTERNAL FLAGS]]>
</Line>
<Line Number="44">
<![CDATA[    // -------------------------------]]>
</Line>
<Line Number="45">
<![CDATA[    Feeder_Extend_Count := 0;]]>
</Line>
<Line Number="46">
<![CDATA[    Start_PB_Storage := Start_PB;]]>
</Line>
<Line Number="47">
<![CDATA[    Blink_Bit := 0;]]>
</Line>
<Line Number="48">
<![CDATA[	HMI_Setup_Done := 0;]]>
</Line>
<Line Number="49">
<![CDATA[	HMI_Trigger_Init := 0;]]>
</Line>
<Line Number="50">
<![CDATA[	Number_of_Positions := 8;]]>
</Line>
<Line Number="51">
<![CDATA[	HMI_All_Tubes_Are_Empty := 0;]]>
</Line>
<Line Number="52">
<![CDATA[	Fill_Indexes_Cleared := 0;]]>
</Line>
<Line Number="53">
<![CDATA[    ]]>
</Line>
<Line Number="54">
<![CDATA[	// REQUEST OPERATOR INPUT]]>
</Line>
<Line Number="55">
<![CDATA[	// -------------------------------]]>
</Line>
<Line Number="56">
<![CDATA[	HMI_Setup_Request := 1;]]>
</Line>
<Line Number="57">
<![CDATA[]]>
</Line>
<Line Number="58">
<![CDATA[    // DONE (RUN ONLY ONCE)]]>
</Line>
<Line Number="59">
<![CDATA[    // -------------------------------]]>
</Line>
<Line Number="60">
<![CDATA[	PLC_Init_Done := 1;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Auto_Feed" Type="ST">
<Description>
<![CDATA[Feeding cylinder step-based machine.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//----// Resume handling: //----//]]>
</Line>
<Line Number="1">
<![CDATA[IF Feed_Resume_OS THEN]]>
</Line>
<Line Number="2">
<![CDATA[    Ball_Feeder_Step        := 00;   // every return to auto re-homes, same as a Stop]]>
</Line>
<Line Number="3">
<![CDATA[    Feeder_Motion_Storage := Ball_Feeder_Retracted OR Ball_Feeder_Intermediate]]>
</Line>
<Line Number="4">
<![CDATA[                               OR Ball_Feeder_Extended;   // no phantom edge on resume]]>
</Line>
<Line Number="5">
<![CDATA[END_IF;]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[//----// Motion one-shot: //----//]]>
</Line>
<Line Number="8">
<![CDATA[Feeder_Motion_Detected_OS := (Ball_Feeder_Retracted OR Ball_Feeder_Intermediate OR Ball_Feeder_Extended)]]>
</Line>
<Line Number="9">
<![CDATA[                                  AND NOT Feeder_Motion_Storage;]]>
</Line>
<Line Number="10">
<![CDATA[Feeder_Motion_Storage := Ball_Feeder_Retracted OR Ball_Feeder_Intermediate OR Ball_Feeder_Extended;]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[//----// Lift timeout: //----//]]>
</Line>
<Line Number="13">
<![CDATA[IF Feeder_Extend_Count < 5 THEN]]>
</Line>
<Line Number="14">
<![CDATA[    Feeder_Lift_Timeout_Timer.PRE := 4000;]]>
</Line>
<Line Number="15">
<![CDATA[ELSE]]>
</Line>
<Line Number="16">
<![CDATA[    Feeder_Lift_Timeout_Timer.PRE := 6000;]]>
</Line>
<Line Number="17">
<![CDATA[END_IF;]]>
</Line>
<Line Number="18">
<![CDATA[Feeder_Lift_Timeout_Timer.TimerEnable := Lift_Ball_Feeder;]]>
</Line>
<Line Number="19">
<![CDATA[Feeder_Lift_Timeout_Timer.Reset       := NOT Lift_Ball_Feeder OR Feed_Resume_OS;]]>
</Line>
<Line Number="20">
<![CDATA[TONR(Feeder_Lift_Timeout_Timer);]]>
</Line>
<Line Number="21">
<![CDATA[]]>
</Line>
<Line Number="22">
<![CDATA[// Lift margin monitor: longest normal stroke of each type, in ms]]>
</Line>
<Line Number="23">
<![CDATA[IF Ball_Feeder_Step = 10 THEN]]>
</Line>
<Line Number="24">
<![CDATA[    IF Feeder_Extend_Count < 5 THEN]]>
</Line>
<Line Number="25">
<![CDATA[        IF Feeder_Lift_Timeout_Timer.ACC > Lift_Time_Max THEN Lift_Time_Max := Feeder_Lift_Timeout_Timer.ACC; END_IF;]]>
</Line>
<Line Number="26">
<![CDATA[    ELSE]]>
</Line>
<Line Number="27">
<![CDATA[        IF Feeder_Lift_Timeout_Timer.ACC > Lift_Time_Max_Full THEN Lift_Time_Max_Full := Feeder_Lift_Timeout_Timer.ACC; END_IF;]]>
</Line>
<Line Number="28">
<![CDATA[    END_IF;]]>
</Line>
<Line Number="29">
<![CDATA[END_IF;]]>
</Line>
<Line Number="30">
<![CDATA[]]>
</Line>
<Line Number="31">
<![CDATA[IF Feeder_Lift_Timeout_Timer.DN AND NOT Feeder_Motion_Detected_OS THEN]]>
</Line>
<Line Number="32">
<![CDATA[    Fault_Feeder_Lift_Timeout := 1;]]>
</Line>
<Line Number="33">
<![CDATA[END_IF;]]>
</Line>
<Line Number="34">
<![CDATA[]]>
</Line>
<Line Number="35">
<![CDATA[//----// Drop timeout: //----//]]>
</Line>
<Line Number="36">
<![CDATA[IF Feeder_Extend_Count < 5 THEN]]>
</Line>
<Line Number="37">
<![CDATA[    Feeder_Drop_Timeout_Timer.PRE := 3000;]]>
</Line>
<Line Number="38">
<![CDATA[ELSE]]>
</Line>
<Line Number="39">
<![CDATA[    Feeder_Drop_Timeout_Timer.PRE := 5000;]]>
</Line>
<Line Number="40">
<![CDATA[END_IF;]]>
</Line>
<Line Number="41">
<![CDATA[Feeder_Drop_Timeout_Timer.TimerEnable := Drop_Ball_Feeder;]]>
</Line>
<Line Number="42">
<![CDATA[Feeder_Drop_Timeout_Timer.Reset       := NOT Drop_Ball_Feeder OR Feed_Resume_OS;]]>
</Line>
<Line Number="43">
<![CDATA[TONR(Feeder_Drop_Timeout_Timer);]]>
</Line>
<Line Number="44">
<![CDATA[IF Feeder_Drop_Timeout_Timer.DN AND NOT Ball_Feeder_Retracted THEN]]>
</Line>
<Line Number="45">
<![CDATA[    Fault_Feeder_Drop_Timeout := 1;]]>
</Line>
<Line Number="46">
<![CDATA[END_IF;]]>
</Line>
<Line Number="47">
<![CDATA[]]>
</Line>
<Line Number="48">
<![CDATA[//----// Recovery timer: //----//]]>
</Line>
<Line Number="49">
<![CDATA[Feeder_Recovery_Timer.TimerEnable := (Ball_Feeder_Step = 00);]]>
</Line>
<Line Number="50">
<![CDATA[Feeder_Recovery_Timer.Reset       := Ball_Feeder_Retracted OR Feed_Resume_OS;]]>
</Line>
<Line Number="51">
<![CDATA[Feeder_Recovery_Timer.PRE         := 5000;]]>
</Line>
<Line Number="52">
<![CDATA[TONR(Feeder_Recovery_Timer);]]>
</Line>
<Line Number="53">
<![CDATA[]]>
</Line>
<Line Number="54">
<![CDATA[//----// Watchdog: //----//]]>
</Line>
<Line Number="55">
<![CDATA[Feeder_Watchdog_Timer.TimerEnable := (Lift_Ball_Feeder OR Drop_Ball_Feeder) AND (Ball_Feeder_Step <> 00);]]>
</Line>
<Line Number="56">
<![CDATA[Feeder_Watchdog_Timer.Reset       := Feeder_Motion_Detected_OS OR Feed_Resume_OS;]]>
</Line>
<Line Number="57">
<![CDATA[Feeder_Watchdog_Timer.PRE         := 5000;]]>
</Line>
<Line Number="58">
<![CDATA[TONR(Feeder_Watchdog_Timer);]]>
</Line>
<Line Number="59">
<![CDATA[IF Feeder_Watchdog_Timer.DN THEN]]>
</Line>
<Line Number="60">
<![CDATA[    Fault_Feeder_Watchdog := 1;]]>
</Line>
<Line Number="61">
<![CDATA[END_IF;]]>
</Line>
<Line Number="62">
<![CDATA[]]>
</Line>
<Line Number="63">
<![CDATA[//----// Feeder dropped dwell: //----//]]>
</Line>
<Line Number="64">
<![CDATA[Ball_Feeder_Retracted_Timer.TimerEnable := Ball_Feeder_Retracted;]]>
</Line>
<Line Number="65">
<![CDATA[Ball_Feeder_Retracted_Timer.Reset       := NOT Ball_Feeder_Retracted OR Feed_Resume_OS;]]>
</Line>
<Line Number="66">
<![CDATA[Ball_Feeder_Retracted_Timer.PRE         := 400;]]>
</Line>
<Line Number="67">
<![CDATA[TONR(Ball_Feeder_Retracted_Timer);]]>
</Line>
<Line Number="68">
<![CDATA[]]>
</Line>
<Line Number="69">
<![CDATA[//----------------// Recovery //---------------------//|]]>
</Line>
<Line Number="70">
<![CDATA[	IF Feeder_Fault AND NOT Feeder_Fault_Active THEN]]>
</Line>
<Line Number="71">
<![CDATA[    	Feeder_Fault_Active := 1;]]>
</Line>
<Line Number="72">
<![CDATA[    	Ball_Feeder_Step := 00;]]>
</Line>
<Line Number="73">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="74">
<![CDATA[	]]>
</Line>
<Line Number="75">
<![CDATA[		]]>
</Line>
<Line Number="76">
<![CDATA[			]]>
</Line>
<Line Number="77">
<![CDATA[CASE Ball_Feeder_Step OF]]>
</Line>
<Line Number="78">
<![CDATA[	99:// HARD FAULT]]>
</Line>
<Line Number="79">
<![CDATA[	// --------------------------------------------------]]>
</Line>
<Line Number="80">
<![CDATA[	 ]]>
</Line>
<Line Number="81">
<![CDATA[		Lift_Ball_Feeder := 0;]]>
</Line>
<Line Number="82">
<![CDATA[		Drop_Ball_Feeder := 0;]]>
</Line>
<Line Number="83">
<![CDATA[		Feeder_Homing := 0;]]>
</Line>
<Line Number="84">
<![CDATA[		Feeder_Hard_Fault_HMI := 1;    // Hard Fault flag to HMI]]>
</Line>
<Line Number="85">
<![CDATA[	]]>
</Line>
<Line Number="86">
<![CDATA[		IF HMI_Fault_Reset_PB THEN ]]>
</Line>
<Line Number="87">
<![CDATA[			Ball_Feeder_Step := 00;    // Retry Recovery]]>
</Line>
<Line Number="88">
<![CDATA[			]]>
</Line>
<Line Number="89">
<![CDATA[			Feeder_Fault_Active := 0;]]>
</Line>
<Line Number="90">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="91">
<![CDATA[	00:// RECOVERY / INIT]]>
</Line>
<Line Number="92">
<![CDATA[	// --------------------------------------------------]]>
</Line>
<Line Number="93">
<![CDATA[	  ]]>
</Line>
<Line Number="94">
<![CDATA[		Lift_Ball_Feeder := 0;]]>
</Line>
<Line Number="95">
<![CDATA[	 	Drop_Ball_Feeder := 1;]]>
</Line>
<Line Number="96">
<![CDATA[	 	Feeder_Homing := 1;]]>
</Line>
<Line Number="97">
<![CDATA[	 ]]>
</Line>
<Line Number="98">
<![CDATA[	 ]]>
</Line>
<Line Number="99">
<![CDATA[		IF Ball_Feeder_Retracted THEN ]]>
</Line>
<Line Number="100">
<![CDATA[			Ball_Feeder_Step := 05;]]>
</Line>
<Line Number="101">
<![CDATA[			Feeder_Hard_Fault_HMI := 0;]]>
</Line>
<Line Number="102">
<![CDATA[			Fault_Feeder_Drop_Timeout := 0;]]>
</Line>
<Line Number="103">
<![CDATA[			Fault_Feeder_Lift_Timeout := 0;]]>
</Line>
<Line Number="104">
<![CDATA[			Fault_Feeder_Watchdog := 0;]]>
</Line>
<Line Number="105">
<![CDATA[			Drop_Ball_Feeder := 0;]]>
</Line>
<Line Number="106">
<![CDATA[			IF Feeder_Fault_Active THEN]]>
</Line>
<Line Number="107">
<![CDATA[	    	Feeder_Recovery_Attempt_Counter := Feeder_Recovery_Attempt_Counter + 1;]]>
</Line>
<Line Number="108">
<![CDATA[			Feeder_Recovery_Total := Feeder_Recovery_Total + 1;]]>
</Line>
<Line Number="109">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="110">
<![CDATA[		ELSIF Feeder_Recovery_Timer.DN THEN ]]>
</Line>
<Line Number="111">
<![CDATA[			Ball_Feeder_Step := 99;]]>
</Line>
<Line Number="112">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="113">
<![CDATA[	05:// WAIT FOR START]]>
</Line>
<Line Number="114">
<![CDATA[	// --------------------------------------------------]]>
</Line>
<Line Number="115">
<![CDATA[	]]>
</Line>
<Line Number="116">
<![CDATA[    	Lift_Ball_Feeder := 0;]]>
</Line>
<Line Number="117">
<![CDATA[    	Drop_Ball_Feeder := 0;]]>
</Line>
<Line Number="118">
<![CDATA[		Feeder_Homing := 0;]]>
</Line>
<Line Number="119">
<![CDATA[		Feeder_Fault_Active := 0;]]>
</Line>
<Line Number="120">
<![CDATA[    	IF Run_Latch AND NOT Magazine_Full THEN]]>
</Line>
<Line Number="121">
<![CDATA[        	Ball_Feeder_Step := 10;]]>
</Line>
<Line Number="122">
<![CDATA[    	END_IF;]]>
</Line>
<Line Number="123">
<![CDATA[]]>
</Line>
<Line Number="124">
<![CDATA[	10:// LIFT FEED CYLINDER]]>
</Line>
<Line Number="125">
<![CDATA[	// --------------------------------------------------]]>
</Line>
<Line Number="126">
<![CDATA[	]]>
</Line>
<Line Number="127">
<![CDATA[    	Lift_Ball_Feeder := 1;]]>
</Line>
<Line Number="128">
<![CDATA[    	Drop_Ball_Feeder := 0;]]>
</Line>
<Line Number="129">
<![CDATA[    	IF Feeder_Extend_Count < 5 THEN]]>
</Line>
<Line Number="130">
<![CDATA[]]>
</Line>
<Line Number="131">
<![CDATA[        	IF Ball_Feeder_Intermediate OR Ball_Feeder_Extended THEN]]>
</Line>
<Line Number="132">
<![CDATA[            	Ball_Feeder_Step := 20;]]>
</Line>
<Line Number="133">
<![CDATA[				Feeder_Recovery_Attempt_Counter := 0;]]>
</Line>
<Line Number="134">
<![CDATA[        	END_IF;]]>
</Line>
<Line Number="135">
<![CDATA[]]>
</Line>
<Line Number="136">
<![CDATA[    	ELSE]]>
</Line>
<Line Number="137">
<![CDATA[        	IF Ball_Feeder_Extended THEN]]>
</Line>
<Line Number="138">
<![CDATA[            	Ball_Feeder_Step := 20;]]>
</Line>
<Line Number="139">
<![CDATA[            	Feeder_Extend_Count := 0;]]>
</Line>
<Line Number="140">
<![CDATA[				Feeder_Recovery_Attempt_Counter := 0;]]>
</Line>
<Line Number="141">
<![CDATA[        	END_IF;]]>
</Line>
<Line Number="142">
<![CDATA[    	END_IF;]]>
</Line>
<Line Number="143">
<![CDATA[]]>
</Line>
<Line Number="144">
<![CDATA[	20:// DROP FEED CYLINDER]]>
</Line>
<Line Number="145">
<![CDATA[	// --------------------------------------------------]]>
</Line>
<Line Number="146">
<![CDATA[	]]>
</Line>
<Line Number="147">
<![CDATA[    	Lift_Ball_Feeder := 0;]]>
</Line>
<Line Number="148">
<![CDATA[    	Drop_Ball_Feeder := 1;]]>
</Line>
<Line Number="149">
<![CDATA[    	IF Ball_Feeder_Retracted THEN]]>
</Line>
<Line Number="150">
<![CDATA[        	Ball_Feeder_Step := 25;]]>
</Line>
<Line Number="151">
<![CDATA[    	END_IF;]]>
</Line>
<Line Number="152">
<![CDATA[		]]>
</Line>
<Line Number="153">
<![CDATA[	25:// FEED CYLINDER DWELL]]>
</Line>
<Line Number="154">
<![CDATA[	// --------------------------------------------------]]>
</Line>
<Line Number="155">
<![CDATA[		]]>
</Line>
<Line Number="156">
<![CDATA[		IF Ball_Feeder_Retracted_Timer.DN THEN]]>
</Line>
<Line Number="157">
<![CDATA[			Ball_Feeder_Step := 30;]]>
</Line>
<Line Number="158">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="159">
<![CDATA[		]]>
</Line>
<Line Number="160">
<![CDATA[	30:// CYCLE COMPLETE / LOOP]]>
</Line>
<Line Number="161">
<![CDATA[	// --------------------------------------------------]]>
</Line>
<Line Number="162">
<![CDATA[    	IF Magazine_Full THEN]]>
</Line>
<Line Number="163">
<![CDATA[        	Lift_Ball_Feeder := 0;]]>
</Line>
<Line Number="164">
<![CDATA[        	Drop_Ball_Feeder := 0;]]>
</Line>
<Line Number="165">
<![CDATA[        	Ball_Feeder_Step := 0;]]>
</Line>
<Line Number="166">
<![CDATA[        	Feeder_Extend_Count := 0;]]>
</Line>
<Line Number="167">
<![CDATA[]]>
</Line>
<Line Number="168">
<![CDATA[    	ELSE ]]>
</Line>
<Line Number="169">
<![CDATA[       	 	Feeder_Extend_Count := Feeder_Extend_Count + 1;]]>
</Line>
<Line Number="170">
<![CDATA[        	Ball_Feeder_Step := 05;]]>
</Line>
<Line Number="171">
<![CDATA[    	END_IF;]]>
</Line>
<Line Number="172">
<![CDATA[	]]>
</Line>
<Line Number="173">
<![CDATA[END_CASE;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Auto_Sort" Type="ST">
<Description>
<![CDATA[Sorting step-based machine.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//----// Resume handling: //----//]]>
</Line>
<Line Number="1">
<![CDATA[IF Sort_Resume_OS THEN]]>
</Line>
<Line Number="2">
<![CDATA[    Color_Sort_Step := 0;   // every return to auto restarts the sort cycle]]>
</Line>
<Line Number="3">
<![CDATA[END_IF;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[//----// Timers: //----//]]>
</Line>
<Line Number="6">
<![CDATA[Color_Read_Advance_Cylinder_Timer.TimerEnable := (Color_Sort_Step = 5);]]>
</Line>
<Line Number="7">
<![CDATA[Color_Read_Advance_Cylinder_Timer.PRE         := 1000;]]>
</Line>
<Line Number="8">
<![CDATA[TONR(Color_Read_Advance_Cylinder_Timer);]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[Color_Read_Dwell_Timer.TimerEnable := (Color_Sort_Step = 10);]]>
</Line>
<Line Number="11">
<![CDATA[Color_Read_Dwell_Timer.PRE         := 1500;]]>
</Line>
<Line Number="12">
<![CDATA[TONR(Color_Read_Dwell_Timer);]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[Color_Sort_Dwell_Timer.TimerEnable := (Color_Sort_Step = 30);]]>
</Line>
<Line Number="15">
<![CDATA[CASE Selected_Tube OF]]>
</Line>
<Line Number="16">
<![CDATA[    1: Color_Sort_Dwell_Timer.PRE := 1500;]]>
</Line>
<Line Number="17">
<![CDATA[    2: Color_Sort_Dwell_Timer.PRE := 2200;]]>
</Line>
<Line Number="18">
<![CDATA[    3: Color_Sort_Dwell_Timer.PRE := 3200;]]>
</Line>
<Line Number="19">
<![CDATA[ELSE]]>
</Line>
<Line Number="20">
<![CDATA[    Color_Sort_Dwell_Timer.PRE := 3500;]]>
</Line>
<Line Number="21">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="22">
<![CDATA[TONR(Color_Sort_Dwell_Timer);]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[CASE Color_Sort_Step OF ]]>
</Line>
<Line Number="25">
<![CDATA[	0: //INIT]]>
</Line>
<Line Number="26">
<![CDATA[	// --------------------------------------------------	]]>
</Line>
<Line Number="27">
<![CDATA[		Actuate_T1_Diverter := 0;]]>
</Line>
<Line Number="28">
<![CDATA[		Actuate_T2_Diverter := 0;]]>
</Line>
<Line Number="29">
<![CDATA[		Actuate_T3_Diverter := 0;]]>
</Line>
<Line Number="30">
<![CDATA[		Retract_Color_Release_Cylinder := 0;]]>
</Line>
<Line Number="31">
<![CDATA[		Retract_Color_Advance_Cylinder := 0;]]>
</Line>
<Line Number="32">
<![CDATA[		]]>
</Line>
<Line Number="33">
<![CDATA[		Color_Sort_Step := 5;]]>
</Line>
<Line Number="34">
<![CDATA[		]]>
</Line>
<Line Number="35">
<![CDATA[	5: //ADVANCE]]>
</Line>
<Line Number="36">
<![CDATA[	// --------------------------------------------------	]]>
</Line>
<Line Number="37">
<![CDATA[			Retract_Color_Release_Cylinder := 0;]]>
</Line>
<Line Number="38">
<![CDATA[			Retract_Color_Advance_Cylinder := 1;]]>
</Line>
<Line Number="39">
<![CDATA[		IF Color_Scan_Pink THEN]]>
</Line>
<Line Number="40">
<![CDATA[    		Color := Pink;]]>
</Line>
<Line Number="41">
<![CDATA[		ELSIF Color_Scan_Orange THEN]]>
</Line>
<Line Number="42">
<![CDATA[    		Color := Orange;]]>
</Line>
<Line Number="43">
<![CDATA[		ELSIF Color_Scan_Green THEN]]>
</Line>
<Line Number="44">
<![CDATA[    		Color := Green;]]>
</Line>
<Line Number="45">
<![CDATA[		ELSE]]>
</Line>
<Line Number="46">
<![CDATA[    		Color := White;]]>
</Line>
<Line Number="47">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="48">
<![CDATA[		IF Color_Read_Advance_Cylinder_Timer.DN THEN ]]>
</Line>
<Line Number="49">
<![CDATA[			Color_Sort_Step := 10; ]]>
</Line>
<Line Number="50">
<![CDATA[			Retract_Color_Advance_Cylinder := 0;]]>
</Line>
<Line Number="51">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="52">
<![CDATA[			]]>
</Line>
<Line Number="53">
<![CDATA[	10: //TUBE SELECT]]>
</Line>
<Line Number="54">
<![CDATA[	// --------------------------------------------------	]]>
</Line>
<Line Number="55">
<![CDATA[		IF Color_Read_Dwell_Timer.DN THEN ]]>
</Line>
<Line Number="56">
<![CDATA[			IF ((Color = T1_TargetColor) AND NOT T1Full) THEN ]]>
</Line>
<Line Number="57">
<![CDATA[				Selected_Tube := 1;]]>
</Line>
<Line Number="58">
<![CDATA[				]]>
</Line>
<Line Number="59">
<![CDATA[			ELSIF ((Color = T2_TargetColor) AND NOT T2Full) THEN ]]>
</Line>
<Line Number="60">
<![CDATA[				Selected_Tube := 2;]]>
</Line>
<Line Number="61">
<![CDATA[			]]>
</Line>
<Line Number="62">
<![CDATA[			ELSIF ((Color = T3_TargetColor) AND NOT T3Full) THEN ]]>
</Line>
<Line Number="63">
<![CDATA[				Selected_Tube := 3;]]>
</Line>
<Line Number="64">
<![CDATA[			]]>
</Line>
<Line Number="65">
<![CDATA[			ELSE ]]>
</Line>
<Line Number="66">
<![CDATA[				Selected_Tube := 0;]]>
</Line>
<Line Number="67">
<![CDATA[			END_IF;]]>
</Line>
<Line Number="68">
<![CDATA[			]]>
</Line>
<Line Number="69">
<![CDATA[		Color_Sort_Step := 20;]]>
</Line>
<Line Number="70">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="71">
<![CDATA[		   ]]>
</Line>
<Line Number="72">
<![CDATA[	20: //DIVERTER FIRE]]>
</Line>
<Line Number="73">
<![CDATA[	// --------------------------------------------------	]]>
</Line>
<Line Number="74">
<![CDATA[		CASE Selected_Tube OF ]]>
</Line>
<Line Number="75">
<![CDATA[			0:]]>
</Line>
<Line Number="76">
<![CDATA[				Actuate_T1_Diverter := 0;]]>
</Line>
<Line Number="77">
<![CDATA[				Actuate_T2_Diverter := 0;]]>
</Line>
<Line Number="78">
<![CDATA[				Actuate_T3_Diverter := 0;]]>
</Line>
<Line Number="79">
<![CDATA[			1:]]>
</Line>
<Line Number="80">
<![CDATA[				Actuate_T1_Diverter := 1;]]>
</Line>
<Line Number="81">
<![CDATA[				Actuate_T2_Diverter := 0;]]>
</Line>
<Line Number="82">
<![CDATA[				Actuate_T3_Diverter := 0;	]]>
</Line>
<Line Number="83">
<![CDATA[				Tube_Fill_Index[0] := Tube_Fill_Index[0] + 1;]]>
</Line>
<Line Number="84">
<![CDATA[			2:]]>
</Line>
<Line Number="85">
<![CDATA[				Actuate_T1_Diverter := 0;]]>
</Line>
<Line Number="86">
<![CDATA[				Actuate_T2_Diverter := 1;]]>
</Line>
<Line Number="87">
<![CDATA[				Actuate_T3_Diverter := 0;]]>
</Line>
<Line Number="88">
<![CDATA[				Tube_Fill_Index[1] := Tube_Fill_Index[1] + 1;]]>
</Line>
<Line Number="89">
<![CDATA[			3:]]>
</Line>
<Line Number="90">
<![CDATA[				Actuate_T1_Diverter := 0;]]>
</Line>
<Line Number="91">
<![CDATA[				Actuate_T2_Diverter := 0;]]>
</Line>
<Line Number="92">
<![CDATA[				Actuate_T3_Diverter := 1;]]>
</Line>
<Line Number="93">
<![CDATA[				Tube_Fill_Index[2] := Tube_Fill_Index[2] + 1;]]>
</Line>
<Line Number="94">
<![CDATA[		END_CASE;]]>
</Line>
<Line Number="95">
<![CDATA[			]]>
</Line>
<Line Number="96">
<![CDATA[		Color_Sort_Step := 30;]]>
</Line>
<Line Number="97">
<![CDATA[			]]>
</Line>
<Line Number="98">
<![CDATA[	30: //RELEASE]]>
</Line>
<Line Number="99">
<![CDATA[	// --------------------------------------------------	]]>
</Line>
<Line Number="100">
<![CDATA[		Retract_Color_Release_Cylinder := 1;]]>
</Line>
<Line Number="101">
<![CDATA[			]]>
</Line>
<Line Number="102">
<![CDATA[		IF Color_Sort_Dwell_Timer.DN THEN Color_Sort_Step := 0;]]>
</Line>
<Line Number="103">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="104">
<![CDATA[				]]>
</Line>
<Line Number="105">
<![CDATA[END_CASE;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Color_Indexing" Type="ST">
<Description>
<![CDATA[Sorting Array Generation]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[Pink := 1;]]>
</Line>
<Line Number="1">
<![CDATA[Orange := 2;]]>
</Line>
<Line Number="2">
<![CDATA[Green := 3;]]>
</Line>
<Line Number="3">
<![CDATA[White := 0;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[// Sort modes: 0 = manual (the HMI writes each position of Tube[<n>].TargetPattern).]]>
</Line>
<Line Number="6">
<![CDATA[// 1-3 = fill all eight positions with Pink, Orange, or Green.]]>
</Line>
<Line Number="7">
<![CDATA[]]>
</Line>
<Line Number="8">
<![CDATA[FOR t := 0 TO 2 DO]]>
</Line>
<Line Number="9">
<![CDATA[	// HMI writes async; buffer and validate each HMI requested sort mode once per scan.]]>
</Line>
<Line Number="10">
<![CDATA[	req := Tube[t].HMI_SortModeReq;]]>
</Line>
<Line Number="11">
<![CDATA[	IF ((req >= 0) AND (req <= 3)) THEN]]>
</Line>
<Line Number="12">
<![CDATA[		Tube[t].SortMode := req;]]>
</Line>
<Line Number="13">
<![CDATA[		Tube[t].SortModeReq_Invalid := 0;]]>
</Line>
<Line Number="14">
<![CDATA[	ELSE]]>
</Line>
<Line Number="15">
<![CDATA[		Tube[t].SortModeReq_Invalid := 1;]]>
</Line>
<Line Number="16">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="17">
<![CDATA[	]]>
</Line>
<Line Number="18">
<![CDATA[	// Write validated sort mode into TargetPattern when in modes 1-3.]]>
</Line>
<Line Number="19">
<![CDATA[	IF (Tube[t].SortMode > 0) THEN]]>
</Line>
<Line Number="20">
<![CDATA[		FOR i := 0 TO 7 DO]]>
</Line>
<Line Number="21">
<![CDATA[			Tube[t].TargetPattern[i] := Tube[t].SortMode;]]>
</Line>
<Line Number="22">
<![CDATA[		END_FOR;]]>
</Line>
<Line Number="23">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="24">
<![CDATA[	]]>
</Line>
<Line Number="25">
<![CDATA[	// Each tube's target is the color assigned to its next empty position.]]>
</Line>
<Line Number="26">
<![CDATA[	// A full tube has no next position, so its target is -1.]]>
</Line>
<Line Number="27">
<![CDATA[	// Copy FillIndex into INT idx first; unable to use array element as subscript.]]>
</Line>
<Line Number="28">
<![CDATA[	idx := Tube[t].FillIndex;]]>
</Line>
<Line Number="29">
<![CDATA[	IF (Tube[t].Full OR (idx < 0) OR (idx > 7)) THEN]]>
</Line>
<Line Number="30">
<![CDATA[		Tube[t].TargetColor := -1;]]>
</Line>
<Line Number="31">
<![CDATA[	ELSE]]>
</Line>
<Line Number="32">
<![CDATA[		Tube[t].TargetColor := Tube[t].TargetPattern[idx];]]>
</Line>
<Line Number="33">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="34">
<![CDATA[END_FOR;]]>
</Line>
</STContent>
</Routine>
<Routine Name="FaultRecovery" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[]]>
</Line>
</STContent>
</Routine>
<Routine Name="Feed_ProcessBypass" Type="ST">
<Description>
<![CDATA[Homes feeding cylinder and disables feed process.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[Lift_Ball_Feeder := 0;]]>
</Line>
<Line Number="1">
<![CDATA[IF NOT Ball_Feeder_Retracted THEN ]]>
</Line>
<Line Number="2">
<![CDATA[	Drop_Ball_Feeder := 1;]]>
</Line>
<Line Number="3">
<![CDATA[ELSE ]]>
</Line>
<Line Number="4">
<![CDATA[	Drop_Ball_Feeder := 0;]]>
</Line>
<Line Number="5">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Initialization" Type="ST">
<Description>
<![CDATA[Same as Power-Up Handler Initialization routine.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// FORCE SAFE OUTPUTS]]>
</Line>
<Line Number="1">
<![CDATA[// -------------------------------]]>
</Line>
<Line Number="2">
<![CDATA[    Lift_Ball_Feeder := 0;]]>
</Line>
<Line Number="3">
<![CDATA[    Drop_Ball_Feeder := 0;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[    Actuate_T1_Diverter := 0;]]>
</Line>
<Line Number="6">
<![CDATA[    Actuate_T2_Diverter := 0;]]>
</Line>
<Line Number="7">
<![CDATA[    Actuate_T3_Diverter := 0;]]>
</Line>
<Line Number="8">
<![CDATA[	]]>
</Line>
<Line Number="9">
<![CDATA[	Actuate_T1_Drop_Advance := 0;]]>
</Line>
<Line Number="10">
<![CDATA[	Actuate_T1_Drop_Release := 0;]]>
</Line>
<Line Number="11">
<![CDATA[	Actuate_T2_Drop_Advance := 0;]]>
</Line>
<Line Number="12">
<![CDATA[	Actuate_T2_Drop_Release := 0;]]>
</Line>
<Line Number="13">
<![CDATA[	Actuate_T3_Drop_Advance := 0;]]>
</Line>
<Line Number="14">
<![CDATA[	Actuate_T3_Drop_Release := 0;]]>
</Line>
<Line Number="15">
<![CDATA[]]>
</Line>
<Line Number="16">
<![CDATA[    Retract_Color_Advance_Cylinder := 0;]]>
</Line>
<Line Number="17">
<![CDATA[    Retract_Color_Release_Cylinder := 0;]]>
</Line>
<Line Number="18">
<![CDATA[]]>
</Line>
<Line Number="19">
<![CDATA[    Run_Light := 0;]]>
</Line>
<Line Number="20">
<![CDATA[]]>
</Line>
<Line Number="21">
<![CDATA[    //  RESET MACHINE STATE]]>
</Line>
<Line Number="22">
<![CDATA[    // -------------------------------]]>
</Line>
<Line Number="23">
<![CDATA[    Run_Latch := 0;]]>
</Line>
<Line Number="24">
<![CDATA[	System_Mode := 30;]]>
</Line>
<Line Number="25">
<![CDATA[    Feeder_Fault_Active := 0;]]>
</Line>
<Line Number="26">
<![CDATA[	Feeder_Recovery_Attempt_Counter := 0;]]>
</Line>
<Line Number="27">
<![CDATA[    Feeder_Homing := 0;]]>
</Line>
<Line Number="28">
<![CDATA[]]>
</Line>
<Line Number="29">
<![CDATA[    Ball_Feeder_Step := 0;     // start in recovery/home]]>
</Line>
<Line Number="30">
<![CDATA[    Color_Sort_Step := 0;]]>
</Line>
<Line Number="31">
<![CDATA[]]>
</Line>
<Line Number="32">
<![CDATA[    // CLEAR FAULTS]]>
</Line>
<Line Number="33">
<![CDATA[    // -------------------------------]]>
</Line>
<Line Number="34">
<![CDATA[    Fault_Feeder_Drop_Timeout := 0;]]>
</Line>
<Line Number="35">
<![CDATA[    Fault_Feeder_Lift_Timeout := 0;]]>
</Line>
<Line Number="36">
<![CDATA[    Fault_Feeder_Watchdog := 0;]]>
</Line>
<Line Number="37">
<![CDATA[]]>
</Line>
<Line Number="38">
<![CDATA[    // RESET INTERNAL FLAGS]]>
</Line>
<Line Number="39">
<![CDATA[    // -------------------------------]]>
</Line>
<Line Number="40">
<![CDATA[    Feeder_Extend_Count := 0;]]>
</Line>
<Line Number="41">
<![CDATA[    Start_PB_Storage := Start_PB;]]>
</Line>
<Line Number="42">
<![CDATA[    Blink_Bit := 0;]]>
</Line>
<Line Number="43">
<![CDATA[	HMI_Setup_Done := 0;]]>
</Line>
<Line Number="44">
<![CDATA[	HMI_Trigger_Init := 0;]]>
</Line>
<Line Number="45">
<![CDATA[	Number_of_Positions := 8;]]>
</Line>
<Line Number="46">
<![CDATA[	HMI_All_Tubes_Are_Empty := 0;]]>
</Line>
<Line Number="47">
<![CDATA[	Fill_Indexes_Cleared := 0;]]>
</Line>
<Line Number="48">
<![CDATA[    ]]>
</Line>
<Line Number="49">
<![CDATA[	// REQUEST OPERATOR INPUT]]>
</Line>
<Line Number="50">
<![CDATA[	// -------------------------------]]>
</Line>
<Line Number="51">
<![CDATA[	HMI_Setup_Request := 1;]]>
</Line>
<Line Number="52">
<![CDATA[]]>
</Line>
<Line Number="53">
<![CDATA[    // DONE (RUN ONLY ONCE)]]>
</Line>
<Line Number="54">
<![CDATA[    // -------------------------------]]>
</Line>
<Line Number="55">
<![CDATA[	PLC_Init_Done := 1;]]>
</Line>
</STContent>
</Routine>
<Routine Name="MainRoutine" Type="RLL">
<Description>
<![CDATA[Executes subroutine calls.]]>
</Description>
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[System Initialization]]>
</Comment>
<Text>
<![CDATA[XIO(PLC_Init_Done)JSR(Initialization,0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Monitoring and Data Management Subroutines]]>
</Comment>
<Text>
<![CDATA[JSR(SysMon,0)JSR(Mode_Mgmt,0)JSR(SysCtl,0)JSR(TubeFill_Indexing,0)JSR(Color_Indexing,0)JSR(TEMPORARYTubeDrops,0);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[JSR(Mode_Dispatch,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Manual_Ctrl" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[	Lift_Ball_Feeder := HMI_RaiseFeedCylinder AND NOT Ball_Feeder_Extended;]]>
</Line>
<Line Number="1">
<![CDATA[	Drop_Ball_Feeder := HMI_DropFeedCylinder AND NOT Ball_Feeder_Retracted;]]>
</Line>
<Line Number="2">
<![CDATA[	Actuate_T1_Diverter := HMI_Diverter1;]]>
</Line>
<Line Number="3">
<![CDATA[	Actuate_T2_Diverter := HMI_Diverter2;]]>
</Line>
<Line Number="4">
<![CDATA[	Actuate_T3_Diverter := HMI_Diverter3;]]>
</Line>
<Line Number="5">
<![CDATA[	Retract_Color_Advance_Cylinder := HMI_ColorStationAdv;]]>
</Line>
<Line Number="6">
<![CDATA[	Retract_Color_Release_Cylinder := HMI_ColorStationRel;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Mode_Dispatch" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// Stop request handler: (Auto only)]]>
</Line>
<Line Number="1">
<![CDATA[IF ((NOT Run_Latch OR NOT Stop_PB) AND (System_Mode = 30)) THEN]]>
</Line>
<Line Number="2">
<![CDATA[    JSR(StopProcedures, 0);]]>
</Line>
<Line Number="3">
<![CDATA[END_IF;]]>
</Line>
<Line Number="4">
<![CDATA[]]>
</Line>
<Line Number="5">
<![CDATA[Auto_Run_Enable := (Run_Latch AND PLC_Init_Done AND (System_Mode = 30));]]>
</Line>
<Line Number="6">
<![CDATA[]]>
</Line>
<Line Number="7">
<![CDATA[// Feed:]]>
</Line>
<Line Number="8">
<![CDATA[Feed_Run            := (Auto_Run_Enable AND NOT Feed_Bypass);]]>
</Line>
<Line Number="9">
<![CDATA[Feed_Resume_OS      := (Feed_Run AND NOT Feed_Resume_Storage);]]>
</Line>
<Line Number="10">
<![CDATA[Feed_Resume_Storage := Feed_Run;]]>
</Line>
<Line Number="11">
<![CDATA[IF Feed_Run THEN]]>
</Line>
<Line Number="12">
<![CDATA[    JSR(Auto_Feed, 0);]]>
</Line>
<Line Number="13">
<![CDATA[ELSIF Auto_Run_Enable THEN        // Auto with Feed_Bypass on]]>
</Line>
<Line Number="14">
<![CDATA[    JSR(Feed_ProcessBypass, 0);]]>
</Line>
<Line Number="15">
<![CDATA[END_IF;]]>
</Line>
<Line Number="16">
<![CDATA[]]>
</Line>
<Line Number="17">
<![CDATA[// Sort:]]>
</Line>
<Line Number="18">
<![CDATA[Sort_Run            := (Auto_Run_Enable AND NOT Sort_Bypass);]]>
</Line>
<Line Number="19">
<![CDATA[Sort_Resume_OS      := (Sort_Run AND NOT Sort_Resume_Storage);]]>
</Line>
<Line Number="20">
<![CDATA[Sort_Resume_Storage := Sort_Run;]]>
</Line>
<Line Number="21">
<![CDATA[IF Sort_Run THEN]]>
</Line>
<Line Number="22">
<![CDATA[    JSR(Auto_Sort, 0);]]>
</Line>
<Line Number="23">
<![CDATA[ELSIF Auto_Run_Enable THEN        // Auto with Sort_Bypass on]]>
</Line>
<Line Number="24">
<![CDATA[    JSR(Sort_ProcessBypass, 0);]]>
</Line>
<Line Number="25">
<![CDATA[END_IF;]]>
</Line>
<Line Number="26">
<![CDATA[]]>
</Line>
<Line Number="27">
<![CDATA[// Manual and recovery:]]>
</Line>
<Line Number="28">
<![CDATA[IF (PLC_Init_Done AND (System_Mode = 20)) THEN]]>
</Line>
<Line Number="29">
<![CDATA[    JSR(Manual_Ctrl, 0);]]>
</Line>
<Line Number="30">
<![CDATA[END_IF;]]>
</Line>
<Line Number="31">
<![CDATA[IF (PLC_Init_Done AND (System_Mode = 10)) THEN]]>
</Line>
<Line Number="32">
<![CDATA[    JSR(FaultRecovery, 0);]]>
</Line>
<Line Number="33">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Mode_Mgmt" Type="ST">
<Description>
<![CDATA[Mode Selection]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[ModeChangeTimer.TimerEnable := ((HMI_RequestedMode <> System_Mode) AND (HMI_RequestedMode = 20));]]>
</Line>
<Line Number="1">
<![CDATA[ModeChangeTimer.Reset := (HMI_RequestedMode = System_Mode);]]>
</Line>
<Line Number="2">
<![CDATA[TONR(ModeChangeTimer);]]>
</Line>
<Line Number="3">
<![CDATA[]]>
</Line>
<Line Number="4">
<![CDATA[IF (HMI_RequestedMode <> System_Mode) THEN]]>
</Line>
<Line Number="5">
<![CDATA[	//Auto]]>
</Line>
<Line Number="6">
<![CDATA[	IF (HMI_RequestedMode = 30) THEN]]>
</Line>
<Line Number="7">
<![CDATA[		System_Mode := HMI_RequestedMode;]]>
</Line>
<Line Number="8">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="9">
<![CDATA[	//Manual]]>
</Line>
<Line Number="10">
<![CDATA[	IF (HMI_RequestedMode = 20) THEN]]>
</Line>
<Line Number="11">
<![CDATA[		JSR(StopProcedures, 0);]]>
</Line>
<Line Number="12">
<![CDATA[		IF (ModeChangeTimer.DN AND NOT Dropping_Ball_Feeder) THEN]]>
</Line>
<Line Number="13">
<![CDATA[			System_Mode := HMI_RequestedMode;]]>
</Line>
<Line Number="14">
<![CDATA[		END_IF;]]>
</Line>
<Line Number="15">
<![CDATA[	END_IF;]]>
</Line>
<Line Number="16">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Sort_ProcessBypass" Type="ST">
<Description>
<![CDATA[Holds sort cylinders open and disables sort process.]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[Actuate_T1_Diverter := 0;]]>
</Line>
<Line Number="1">
<![CDATA[Actuate_T2_Diverter := 0;]]>
</Line>
<Line Number="2">
<![CDATA[Actuate_T3_Diverter := 0;]]>
</Line>
<Line Number="3">
<![CDATA[Retract_Color_Advance_Cylinder := 1;]]>
</Line>
<Line Number="4">
<![CDATA[Retract_Color_Release_Cylinder := 1;]]>
</Line>
</STContent>
</Routine>
<Routine Name="StopProcedures" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[Ball_Feeder_Step := 00;]]>
</Line>
<Line Number="1">
<![CDATA[Lift_Ball_Feeder := 0;]]>
</Line>
<Line Number="2">
<![CDATA[IF NOT Ball_Feeder_Retracted THEN ]]>
</Line>
<Line Number="3">
<![CDATA[	Dropping_Ball_Feeder := 1;]]>
</Line>
<Line Number="4">
<![CDATA[	Drop_Ball_Feeder := 1;]]>
</Line>
<Line Number="5">
<![CDATA[ELSE ]]>
</Line>
<Line Number="6">
<![CDATA[	Drop_Ball_Feeder := 0;]]>
</Line>
<Line Number="7">
<![CDATA[END_IF;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[Color_Sort_Step := 0;]]>
</Line>
<Line Number="10">
<![CDATA[Retract_Color_Advance_Cylinder := 0;]]>
</Line>
<Line Number="11">
<![CDATA[Retract_Color_Release_Cylinder := 0;]]>
</Line>
<Line Number="12">
<![CDATA[]]>
</Line>
<Line Number="13">
<![CDATA[Actuate_T1_Diverter := 0;]]>
</Line>
<Line Number="14">
<![CDATA[Actuate_T2_Diverter := 0;]]>
</Line>
<Line Number="15">
<![CDATA[Actuate_T3_Diverter := 0;]]>
</Line>
</STContent>
</Routine>
<Routine Name="SysCtl" Type="ST">
<Description>
<![CDATA[System Control]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[Start_PB_RE := (Start_PB AND NOT Start_PB_Storage);]]>
</Line>
<Line Number="1">
<![CDATA[Start_PB_Storage := Start_PB;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[Feeder_Stuck_at_Sensor := (Feeder_Recovery_Attempt_Counter > 3);]]>
</Line>
<Line Number="4">
<![CDATA[Feeder_Fault :=                                                              //Feeder Fault Conditions]]>
</Line>
<Line Number="5">
<![CDATA[    Fault_Feeder_Drop_Timeout OR]]>
</Line>
<Line Number="6">
<![CDATA[	Fault_Feeder_Lift_Timeout OR]]>
</Line>
<Line Number="7">
<![CDATA[	Fault_Feeder_Watchdog;]]>
</Line>
<Line Number="8">
<![CDATA[	]]>
</Line>
<Line Number="9">
<![CDATA[Fault := ((Feeder_Stuck_at_Sensor OR Feeder_Fault) AND NOT Feeder_Homing);]]>
</Line>
<Line Number="10">
<![CDATA[Run_Allowed := Stop_PB AND HMI_Setup_Done AND PLC_Init_Done AND NOT Fault;]]>
</Line>
<Line Number="11">
<![CDATA[Run_Latch := ((Run_Latch OR Start_PB_RE) AND Stop_PB AND Run_Allowed AND (System_Mode = 30));]]>
</Line>
<Line Number="12">
<![CDATA[System_Standby := Run_Allowed AND NOT Run_Latch;]]>
</Line>
<Line Number="13">
<![CDATA[]]>
</Line>
<Line Number="14">
<![CDATA[IF Fault THEN                                                                //Run Light ]]>
</Line>
<Line Number="15">
<![CDATA[	Run_Light := Fault_Blink;]]>
</Line>
<Line Number="16">
<![CDATA[ELSE ]]>
</Line>
<Line Number="17">
<![CDATA[	Run_Light := Run_Latch;         ]]>
</Line>
<Line Number="18">
<![CDATA[END_IF;]]>
</Line>
<Line Number="19">
<![CDATA[]]>
</Line>
<Line Number="20">
<![CDATA[IF HMI_Fault_Reset_PB THEN                                                       //Fault Reset]]>
</Line>
<Line Number="21">
<![CDATA[	Fault_Feeder_Drop_Timeout := 0;]]>
</Line>
<Line Number="22">
<![CDATA[	Fault_Feeder_Lift_Timeout := 0;]]>
</Line>
<Line Number="23">
<![CDATA[	Fault_Feeder_Watchdog := 0;]]>
</Line>
<Line Number="24">
<![CDATA[	Feeder_Stuck_at_Sensor := 0; ]]>
</Line>
<Line Number="25">
<![CDATA[	Feeder_Recovery_Attempt_Counter := 0;]]>
</Line>
<Line Number="26">
<![CDATA[END_IF;]]>
</Line>
<Line Number="27">
<![CDATA[]]>
</Line>
<Line Number="28">
<![CDATA[// Bypass only after the current ball finishes (sort back at step 0),]]>
</Line>
<Line Number="29">
<![CDATA[// Drop out as soon as any tube has room again.]]>
</Line>
<Line Number="30">
<![CDATA[Sort_Bypass := (All_Tubes_Full AND (Sort_Bypass OR (Color_Sort_Step = 0)));]]>
</Line>
</STContent>
</Routine>
<Routine Name="SysMon" Type="ST">
<Description>
<![CDATA[System Monitoring]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//                                NOTES:]]>
</Line>
<Line Number="1">
<![CDATA[//			HMI_Page_State (s) are: 1-Init; 2-Home; 3-Config; 4-Manual]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[IF HMI_Trigger_Init THEN ]]>
</Line>
<Line Number="4">
<![CDATA[	PLC_Init_Done := 0;]]>
</Line>
<Line Number="5">
<![CDATA[END_IF;]]>
</Line>
<Line Number="6">
<![CDATA[IF (HMI_Page_State = 1) THEN ]]>
</Line>
<Line Number="7">
<![CDATA[	HMI_Setup_Request := 0;]]>
</Line>
<Line Number="8">
<![CDATA[END_IF;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[Fault_Blink := (Fault AND Blink_Bit);                                        //Fault Blink]]>
</Line>
<Line Number="11">
<![CDATA[]]>
</Line>
<Line Number="12">
<![CDATA[//----// Global 1Hz Blink Timer //----//|]]>
</Line>
<Line Number="13">
<![CDATA[One_Sec_Blink_Timer.TimerEnable := 1;]]>
</Line>
<Line Number="14">
<![CDATA[One_Sec_Blink_Timer.PRE := 500;]]>
</Line>
<Line Number="15">
<![CDATA[TONR(One_Sec_Blink_Timer);]]>
</Line>
<Line Number="16">
<![CDATA[IF One_Sec_Blink_Timer.DN THEN]]>
</Line>
<Line Number="17">
<![CDATA[	One_Sec_Blink_Timer.Reset := 1;]]>
</Line>
<Line Number="18">
<![CDATA[	Blink_Bit := NOT Blink_Bit;]]>
</Line>
<Line Number="19">
<![CDATA[ELSE]]>
</Line>
<Line Number="20">
<![CDATA[	One_Sec_Blink_Timer.Reset := 0;]]>
</Line>
<Line Number="21">
<![CDATA[END_IF;]]>
</Line>
<Line Number="22">
<![CDATA[//------------------------------------//|]]>
</Line>
<Line Number="23">
<![CDATA[]]>
</Line>
<Line Number="24">
<![CDATA[IF (T1Full AND T2Full AND T3Full) THEN]]>
</Line>
<Line Number="25">
<![CDATA[	All_Tubes_Full := 1;]]>
</Line>
<Line Number="26">
<![CDATA[ELSE ]]>
</Line>
<Line Number="27">
<![CDATA[	All_Tubes_Full := 0;]]>
</Line>
<Line Number="28">
<![CDATA[END_IF;]]>
</Line>
<Line Number="29">
<![CDATA[]]>
</Line>
<Line Number="30">
<![CDATA[IF Drop_Ball_Feeder THEN]]>
</Line>
<Line Number="31">
<![CDATA[	Dropping_Ball_Feeder := 1;]]>
</Line>
<Line Number="32">
<![CDATA[ELSE]]>
</Line>
<Line Number="33">
<![CDATA[	Dropping_Ball_Feeder := 0;]]>
</Line>
<Line Number="34">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="TEMPORARYTubeDrops" Type="ST">
<Description>
<![CDATA[To be replaced by tube emptying + ball shuffling subroutine(s)]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[// Close Tube Drops (TEMPORARY)]]>
</Line>
<Line Number="1">
<![CDATA[IF Run_Latch THEN              ]]>
</Line>
<Line Number="2">
<![CDATA[	Actuate_T1_Drop_Advance := 0;]]>
</Line>
<Line Number="3">
<![CDATA[	Actuate_T1_Drop_Release := 1;]]>
</Line>
<Line Number="4">
<![CDATA[	Actuate_T2_Drop_Advance := 0;]]>
</Line>
<Line Number="5">
<![CDATA[	Actuate_T2_Drop_Release := 1;]]>
</Line>
<Line Number="6">
<![CDATA[	Actuate_T3_Drop_Advance := 0;]]>
</Line>
<Line Number="7">
<![CDATA[	Actuate_T3_Drop_Release := 1;]]>
</Line>
<Line Number="8">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
<Routine Name="TubeFill_Indexing" Type="ST">
<Description>
<![CDATA[Capacity Array Generation]]>
</Description>
<STContent>
<Line Number="0">
<![CDATA[//                                NOTES:]]>
</Line>
<Line Number="1">
<![CDATA[//			HMI_All_Tubes_Are_Empty States: 0-UNDEF; 10-Yes; 20-No;]]>
</Line>
<Line Number="2">
<![CDATA[]]>
</Line>
<Line Number="3">
<![CDATA[IF ((HMI_All_Tubes_Are_Empty = 10) AND NOT Fill_Indexes_Cleared) THEN ]]>
</Line>
<Line Number="4">
<![CDATA[Tube_Fill_Index[0] := 0; ]]>
</Line>
<Line Number="5">
<![CDATA[Tube_Fill_Index[1] := 0; ]]>
</Line>
<Line Number="6">
<![CDATA[Tube_Fill_Index[2] := 0;]]>
</Line>
<Line Number="7">
<![CDATA[Fill_Indexes_Cleared := 1;]]>
</Line>
<Line Number="8">
<![CDATA[END_IF;]]>
</Line>
<Line Number="9">
<![CDATA[]]>
</Line>
<Line Number="10">
<![CDATA[T1Full := (Tube_Fill_Index[0] >= Number_of_Positions);]]>
</Line>
<Line Number="11">
<![CDATA[T2Full := (Tube_Fill_Index[1] >= Number_of_Positions);]]>
</Line>
<Line Number="12">
<![CDATA[T3Full := (Tube_Fill_Index[2] >= Number_of_Positions);]]>
</Line>
<Line Number="13">
<![CDATA[//Clamp]]>
</Line>
<Line Number="14">
<![CDATA[IF (Tube_Fill_Index[0] > Number_of_Positions) THEN]]>
</Line>
<Line Number="15">
<![CDATA[	Tube_Fill_Index[0] := Number_of_Positions;]]>
</Line>
<Line Number="16">
<![CDATA[END_IF;   ]]>
</Line>
<Line Number="17">
<![CDATA[IF (Tube_Fill_Index[1] > Number_of_Positions) THEN]]>
</Line>
<Line Number="18">
<![CDATA[	Tube_Fill_Index[1] := Number_of_Positions;]]>
</Line>
<Line Number="19">
<![CDATA[END_IF;]]>
</Line>
<Line Number="20">
<![CDATA[IF (Tube_Fill_Index[2] > Number_of_Positions) THEN]]>
</Line>
<Line Number="21">
<![CDATA[	Tube_Fill_Index[2] := Number_of_Positions;]]>
</Line>
<Line Number="22">
<![CDATA[END_IF;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
<CST MasterID="0"/>
<WallClockTime LocalTimeAdjustment="0" TimeZone="0"/>
<Trends/>
<DataLogs/>
<TimeSynchronize Priority1="128" Priority2="128" PTPEnable="false"/>
<EthernetPorts>
<EthernetPort Port="1" Label="1" PortEnabled="true"/>
<EthernetPort Port="2" Label="2" PortEnabled="true"/>
</EthernetPorts>
<EthernetNetwork SupervisorModeEnabled="false" SupervisorPrecedence="0" BeaconInterval="400" BeaconTimeout="1960" VLANID="0"/>
</Controller>
