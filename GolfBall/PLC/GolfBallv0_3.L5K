			'    FOR i := 0 TO 7 DO
			'        T3_Color[i] := HMI_T3SortMode;
			'    END_FOR;
			'END_IF;
			'
			'// Each tube's target is the color assigned to its next empty position.
			'// A full tube has no next position, so its target is -1, which no ball can match.
			'// Logix won't accept an array element as a subscript; each fill count
			'// writes into an INT first.
			'idx1 := Tube_Fill_Index[0];
			'idx2 := Tube_Fill_Index[1];
			'idx3 := Tube_Fill_Index[2];
			'
			'IF (T1Full OR (idx1 < 0) OR (idx1 > 7)) THEN
