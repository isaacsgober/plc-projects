		ST_ROUTINE Color_Indexing (Description := "Sorting Array Generation")
			'Pink := 1;
			'Orange := 2;
			'Green := 3;
			'White := 0;
			'
			'// Sort modes: 0 = manual (the HMI writes each position of T<N>_Color),
			'// 1-3 = fill all eight positions with Pink, Orange, or Green.
			'IF (HMI_T1SortMode > 0) THEN
			'    FOR i := 0 TO 7 DO
			'        T1_Color[i] := HMI_T1SortMode;
			'    END_FOR;
			'END_IF;
			'IF (HMI_T2SortMode > 0) THEN
			'    FOR i := 0 TO 7 DO
